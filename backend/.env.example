APP_ENV=development
DATABASE_URL=postgresql+psycopg://testforge:testforge@localhost:5432/testforge
APP_SECRET_KEY=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARTIFACT_DIR=./artifacts
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
RUNNER_MODE=local
MAX_RUN_SECONDS=90
SANDBOX_WORKER_URL=
SANDBOX_WORKER_TOKEN=
REPAIR_SANDBOX=docker
REPAIR_ALLOW_UNSAFE_PROCESS=false
REPAIR_MAX_UPLOAD_MB=100
# Optional: require header X-Admin-Token on /api/settings/* (recommended when deployed publicly)
SETTINGS_ADMIN_TOKEN=
# Allow localhost/private AI base URLs (self-hosted models). Keep false in production.
AI_ALLOW_PRIVATE_URL=false
